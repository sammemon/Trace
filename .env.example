NODE_ENV=development
PORT=3000
# Supabase project connection (use the Prisma/transaction pooler URL from Project Settings > Database)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
PRIVATE_DATA_KEY=replace-with-32-byte-hex-key
STUDENT_ID_HMAC_SECRET=replace-with-a-long-random-secret
ALLOWED_EMAIL_DOMAINS=students.muet.edu.pk,faculty.muet.edu.pk,admin.muet.edu.pk,hod.muet.edu.pk
UNIVERSITY_NAME=Mehran University (MUET)
UNIVERSITY_TIMEZONE=Asia/Karachi
CAMPUS_CENTER_LAT=24.8607
CAMPUS_CENTER_LNG=67.0011
# Supabase configuration (Next.js client-side)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[KEY]
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=trace-media
S3_ACCESS_KEY=trace
S3_SECRET_KEY=trace-minio-password
S3_PUBLIC_BASE_URL=http://localhost:9000/trace-media
ADMIN_ORIGIN=http://localhost:5173
