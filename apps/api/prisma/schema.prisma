generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  ACTIVE
  CLAIM_PENDING
  RETURNED
  RESOLVED
  EXPIRED
  REMOVED
}

enum ModerationStatus {
  VISIBLE
  PENDING_REVIEW
  HIDDEN
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ClaimStatus {
  PENDING
  MORE_INFO_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum ConversationStatus {
  OPEN
  READ_ONLY
  CLOSED
}

enum MessageType {
  TEXT
  SYSTEM
}

enum ReportTargetType {
  ITEM
  USER
  MESSAGE
  CLAIM
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  department      String
  batchYear       Int        @map("batch_year")
  studentIdHash   String?    @map("student_id_hash")
  role            Role       @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  trustScore      Int        @default(50) @map("trust_score")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")
  avatarUrl       String?    @map("avatar_url")
  bio             String?
  notificationPrefs String      @default("{}") @map("notification_prefs")
  quietHours      String?      @map("quiet_hours")
  locale          String     @default("en")
  items           Item[]
  otpCodes        OtpCode[]
  refreshTokens   RefreshToken[]
  deviceTokens    DeviceToken[]
  bookmarks       Bookmark[]
  savedSearches   SavedSearch[]
  claims          Claim[]
  conversationsA  Conversation[] @relation("conversationUserA")
  conversationsB  Conversation[] @relation("conversationUserB")
  messages        Message[]
  notifications   Notification[]
  reports         Report[]
  handledReports  Report[] @relation("handledReports")
  auditLogs       AuditLog[]
  blocksCreated   Block[] @relation("blocker")
  blocksReceived  Block[] @relation("blocked")

  @@index([studentIdHash])
  @@map("users")
}

model DeviceToken {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  expoPushToken  String   @unique @map("expo_push_token")
  platform       String
  appVersion     String?  @map("app_version")
  lastActiveAt   DateTime @default(now()) @map("last_active_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  familyId    String    @map("family_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String     @id @default(uuid())
  email      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  userId     String?    @map("user_id")
  user       User?      @relation(fields: [userId], references: [id])

  @@index([email, purpose, expiresAt])
  @@map("otp_codes")
}

model Category {
  id                     String   @id @default(uuid())
  name                   String
  slug                   String   @unique
  icon                   String
  isSensitive            Boolean  @default(false) @map("is_sensitive")
  verificationTemplates String     @default("[]") @map("verification_templates")
  sortOrder              Int      @default(0) @map("sort_order")
  isActive               Boolean  @default(true) @map("is_active")
  items                  Item[]
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model CampusLocation {
  id                    String   @id @default(uuid())
  name                  String
  type                  String
  lat Float  
  lng Float  
  description           String?
  isSafeHandoverPoint   Boolean  @default(false) @map("is_safe_handover_point")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  items                 Item[]
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([name, type])
  @@map("campus_locations")
}

model Item {
  id                 String           @id @default(uuid())
  type               ItemType
  title              String
  description        String
  categoryId         String           @map("category_id")
  color              String?
  brand              String?
  tags String 
  locationId         String           @map("location_id")
  locationNote       String?          @map("location_note")
  occurredAt         DateTime         @map("occurred_at")
  isTimeApproximate  Boolean          @default(false) @map("is_time_approximate")
  status             ItemStatus       @default(ACTIVE)
  moderationStatus   ModerationStatus @default(VISIBLE) @map("moderation_status")
  handoverMode       String?          @map("handover_mode")
  privateDetailsEnc  String?          @map("private_details_enc")
  idNumberHash       String?          @map("id_number_hash")
  viewCount          Int              @default(0) @map("view_count")
  expiresAt          DateTime         @map("expires_at")
  resolvedAt         DateTime?        @map("resolved_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  lastRenewedAt      DateTime?        @map("last_renewed_at")
  reporterId         String           @map("reporter_id")
  reporter           User             @relation(fields: [reporterId], references: [id])
  category           Category         @relation(fields: [categoryId], references: [id])
  location           CampusLocation   @relation(fields: [locationId], references: [id])
  bookmarks          Bookmark[]
  images             ItemImage[]
  verificationQuestions String?       @map("verification_questions")
  claims              Claim[]
  matchesAsLost       Match[] @relation("lostItemMatches")
  matchesAsFound      Match[] @relation("foundItemMatches")

  @@index([status, moderationStatus, createdAt])
  @@index([categoryId])
  @@map("items")
}

model Block {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Bookmark {
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("bookmarks")
}

model ItemImage {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  objectKey   String   @map("object_key")
  url         String
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  width       Int?
  height      Int?
  position    Int      @default(0)
  isCover     Boolean  @default(false) @map("is_cover")
  createdAt   DateTime @default(now()) @map("created_at")
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
  @@map("item_images")
}

model SavedSearch {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  query           String
  filters         String     @default("{}")
  notify          Boolean  @default(true)
  lastNotifiedAt  DateTime? @map("last_notified_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("saved_searches")
}

model Match {
  id          String   @id @default(uuid())
  lostItemId  String   @map("lost_item_id")
  foundItemId String   @map("found_item_id")
  score       Int
  reasons     String     @default("[]")
  status      String   @default("NEW")
  createdAt   DateTime @default(now()) @map("created_at")
  lostItem    Item     @relation("lostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem   Item     @relation("foundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)

  @@unique([lostItemId, foundItemId])
  @@index([lostItemId, score])
  @@map("matches")
}

model Claim {
  id            String      @id @default(uuid())
  itemId        String      @map("item_id")
  claimantId    String      @map("claimant_id")
  status        ClaimStatus @default(PENDING)
  message       String
  decisionNote  String?     @map("decision_note")
  rejectionReason String?   @map("rejection_reason")
  decidedAt     DateTime?   @map("decided_at")
  expiresAt     DateTime    @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  item          Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimant      User       @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  answers       ClaimAnswer[]
  conversation Conversation?
  handoverCodeHash String?    @map("handover_code_hash")
  handoverCodeExpiresAt DateTime? @map("handover_code_expires_at")
  handoverAttempts Int        @default(0) @map("handover_attempts")
  handoverLockedUntil DateTime? @map("handover_locked_until")
  completedAt   DateTime?      @map("completed_at")

  @@unique([itemId, claimantId])
  @@index([itemId, status])
  @@index([claimantId, createdAt])
  @@map("claims")
}

model ClaimAnswer {
  id         String   @id @default(uuid())
  claimId    String   @map("claim_id")
  question   String
  answer     String
  createdAt  DateTime @default(now()) @map("created_at")
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("claim_answers")
}

model Conversation {
  id        String             @id @default(uuid())
  claimId   String             @unique @map("claim_id")
  itemId    String             @map("item_id")
  userAId   String             @map("user_a_id")
  userBId   String             @map("user_b_id")
  status    ConversationStatus @default(OPEN)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  claim     Claim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userA     User               @relation("conversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User               @relation("conversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userAId, updatedAt])
  @@index([userBId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  senderId       String         @map("sender_id")
  type           MessageType    @default(TEXT)
  body           String
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  data      String     @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Report {
  id             String           @id @default(uuid())
  reporterId     String           @map("reporter_id")
  targetType     ReportTargetType @map("target_type")
  targetId       String           @map("target_id")
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  handledById    String?          @map("handled_by")
  resolutionNote String?         @map("resolution_note")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  reporter       User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  handledBy     User?            @relation("handledReports", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   String     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("audit_logs")
}


