{
  "name": "@trace/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cd ../../packages/shared && pnpm build && cd ../../apps/api && pnpm exec prisma generate && nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name foundation",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/platform-socket.io": "^11.0.11",
    "@nestjs/schedule": "^6.0.1",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/websockets": "^11.0.11",
    "@prisma/client": "^6.3.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "argon2": "^0.41.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2",
    "@trace/shared": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
