{
  "name": "@trace/admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "cap:init": "npx cap init TRACE com.muet.trace --web-dir=dist",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk:debug": "pnpm build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk:release": "pnpm build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "postinstall": "npx cap init TRACE com.muet.trace --web-dir=dist 2>/dev/null || true"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/device": "^6.1.0",
    "@capacitor/filesystem": "^6.1.0",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/network": "^6.1.0",
    "@capacitor/push-notifications": "^6.1.0",
    "@capacitor/splash-screen": "^6.1.0",
    "@capacitor/status-bar": "^6.1.0",
    "@capacitor/keyboard": "^6.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
